# Created by `npx convex dev` after you select the existing "the patio" project.
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Set these in the Convex dashboard under Settings > Environment Variables.
# ADMIN_USERNAME=patio-admin
# ADMIN_PASSWORD=choose-a-long-unique-password

# Set these in Convex Settings > Environment Variables (not in browser/VITE variables).
# CLOVER_MERCHANT_ID=your-merchant-id
# CLOVER_PRIVATE_TOKEN=your-hosted-checkout-private-token
# CLOVER_API_BASE_URL=https://api.clover.com
# CLOVER_WEBHOOK_SECRET=generated-in-clover-hosted-checkout-settings
# PUBLIC_SITE_URL=https://your-public-site.example
